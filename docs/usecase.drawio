<mxfile host="app.diagrams.net"><diagram id="uc-l02" name="Use Case L02"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="HỆ THỐNG SMART CRM – L02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="182" y="28" width="728" height="581" as="geometry"/></mxCell><mxCell id="UC01" value="UC01&#xa;Tra cứu khách hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="189" y="89" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC02" value="UC02&#xa;Tạo khách hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="448" y="89" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC03" value="UC03&#xa;Ghi nhận thiết bị&#xa;và mô tả lỗi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="434" y="299" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC06" value="UC06&#xa;Tính/xem hạn cam kết" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="299" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC04" value="UC04&#xa;Chọn nhóm sự cố" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="189" y="236" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC05" value="UC05&#xa;Chọn mức ưu tiên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="189" y="369" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC07" value="UC07&#xa;Xem/lọc danh sách phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="308" y="516" width="196" height="74" as="geometry"/></mxCell><mxCell id="UC08" value="UC08&#xa;Nhận diện phiếu&#xa;sắp đến hạn/quá hạn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EDF7;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="516" width="196" height="74" as="geometry"/></mxCell><mxCell id="A1" value="Nhân viên&#xa;tiếp nhận" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="69" y="299" width="30" height="60" as="geometry"/></mxCell><mxCell id="A2" value="Quản lý&#xa;trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="69" y="551" width="30" height="60" as="geometry"/></mxCell><mxCell id="A3" value="Bộ đếm&#xa;thời gian" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1021" y="551" width="30" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="A1" target="UC01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="A1" target="UC03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="A2" target="UC07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="A3" target="UC08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontStyle=2;fontSize=12;" edge="1" parent="1" source="UC02" target="UC01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontStyle=2;fontSize=12;" edge="1" parent="1" source="UC04" target="UC03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontStyle=2;fontSize=12;" edge="1" parent="1" source="UC05" target="UC03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontStyle=2;fontSize=12;" edge="1" parent="1" source="UC03" target="UC06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontStyle=2;fontSize=12;" edge="1" parent="1" source="UC07" target="UC08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú thích ký hiệu:&lt;/b&gt;&lt;br&gt;• Hình chữ nhật lớn: ranh giới hệ thống Smart CRM – L02.&lt;br&gt;• Hình người (actor): người dùng hoặc tác nhân bên ngoài hệ thống (Nhân viên tiếp nhận, Quản lý trung tâm, Bộ đếm thời gian).&lt;br&gt;• Hình elip: một use case (chức năng của hệ thống).&lt;br&gt;• Đường liền: actor tham gia use case.&lt;br&gt;• Mũi tên đứt «include»: use case gốc luôn gọi use case được include; mũi tên trỏ từ use case gốc đến use case được include.&lt;br&gt;• Mũi tên đứt «extend»: use case mở rộng, chỉ xảy ra khi có điều kiện; mũi tên trỏ từ use case mở rộng về use case gốc.&lt;br&gt;• Use case được include/extend được thực hiện thông qua use case gốc nên không nối trực tiếp với actor." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="182" y="625" width="728" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>