<mxfile host="app.diagrams.net"><diagram id="ERD L02" name="ERD L02"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="customer" value="&lt;b&gt;customer&lt;/b&gt;&lt;hr/&gt;PK customer_id&lt;br/&gt;full_name&lt;br/&gt;phone (UNIQUE)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1F4E79;strokeWidth=2;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="94" as="geometry"/></mxCell><mxCell id="device" value="&lt;b&gt;device&lt;/b&gt;&lt;hr/&gt;PK device_id&lt;br/&gt;FK customer_id&lt;br/&gt;serial_imei (UNIQUE)&lt;br/&gt;warranty_end_date" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1F4E79;strokeWidth=2;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="240" height="114" as="geometry"/></mxCell><mxCell id="ticket" value="&lt;b&gt;ticket&lt;/b&gt;&lt;hr/&gt;PK ticket_id&lt;br/&gt;ticket_code (UNIQUE)&lt;br/&gt;FK device_id&lt;br/&gt;FK category_id&lt;br/&gt;description&lt;br/&gt;priority&lt;br/&gt;status&lt;br/&gt;commitment_deadline&lt;br/&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1F4E79;strokeWidth=2;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="240" height="214" as="geometry"/></mxCell><mxCell id="category" value="&lt;b&gt;issue_category&lt;/b&gt;&lt;hr/&gt;PK category_id&lt;br/&gt;category_name (UNIQUE)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1F4E79;strokeWidth=2;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="240" height="74" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;ticket_status_log&lt;/b&gt;&lt;hr/&gt;PK log_id&lt;br/&gt;FK ticket_id&lt;br/&gt;status&lt;br/&gt;changed_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeColor=#1F4E79;strokeWidth=2;fillColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="240" height="114" as="geometry"/></mxCell><mxCell id="r1" value="1 — N (sở hữu)" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="customer" target="device"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="1 — N (có phiếu)" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="device" target="ticket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="1 — N (phân loại)" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="category" target="ticket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="1 — N (lịch sử)" style="endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="ticket" target="log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú thích ký hiệu&lt;/b&gt;&lt;br/&gt;PK = khóa chính (Primary Key).&lt;br/&gt;FK = khóa ngoại (Foreign Key).&lt;br/&gt;1 — N = quan hệ một–nhiều (phía 1 là bảng cha, phía N là bảng con).&lt;br/&gt;ticket liên kết customer gián tiếp qua device.customer_id; không có ticket.customer_id.&lt;br/&gt;ERD chỉ chứa các cột có trong db/schema.sql (PostgreSQL 18)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="960" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>